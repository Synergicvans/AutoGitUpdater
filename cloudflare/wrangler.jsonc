{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autogitupdater-timer",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "GITHUB_REPOSITORY": "Synergicvans/AutoGitUpdater",
    "ENABLED": "true",
    "DRY_RUN": "false"
  },
  "triggers": {
    "crons": ["30,40,50 13 * * *", "*/10 14-17 * * *", "0,10,20 18 * * *"]
  },
  "observability": { "enabled": true }
}
